# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your values
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port the FastAPI server listens on (hosting platforms override this automatically)
PORT=8000

# ── Engine ────────────────────────────────────────────────────────────────────

# Number of MCTS simulations per bot move.
# Higher = stronger but slower.
#   Free tier (Render)   : 50  (stays under 7s response limit)
#   Paid / local         : 150-300
MCTS_SIMS=80

# ── Training (Train.py) ───────────────────────────────────────────────────────

# Self-play games per training iteration
TRAIN_GAMES=15

# MCTS simulations per move during self-play
TRAIN_SIMS=80

# Number of training iterations to run
TRAIN_ITERS=200

# Number of parallel A3C worker threads (set to your CPU core count)
TRAIN_WORKERS=2
